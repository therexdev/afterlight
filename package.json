{
  "name": "afterlight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:contract": "node scripts/build-contract.mjs",
    "build:collection": "node scripts/prepare-collection.mjs",
    "build:web": "node scripts/build-web.mjs && node scripts/build-utilities.mjs",
    "build": "npm run build:contract && npm run build:collection && npm run build:web",
    "test": "node --test tests/*.test.mjs",
    "test:contract": "node scripts/test-contract.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "optimize:art": "node scripts/optimize-collection.mjs",
    "prepare:wallet": "node scripts/launch.mjs prepare",
    "launch:plan": "node scripts/launch.mjs plan",
    "launch:upload": "node scripts/launch.mjs upload",
    "launch:verify": "node scripts/launch.mjs verify",
    "launch:open": "node scripts/launch.mjs open"
  },
  "dependencies": {
    "koilib": "9.4.0"
  },
  "devDependencies": {
    "@as-pect/assembly": "8.0.0",
    "@as-pect/cli": "8.0.0",
    "@as-pect/core": "8.0.0",
    "@koinos/as-proto-gen": "1.0.0",
    "@koinos/mock-vm": "1.3.0",
    "@koinos/sdk-as": "1.5.1",
    "@roamin/protoc": "2.5.0",
    "assemblyscript": "0.28.20",
    "esbuild": "0.28.2",
    "protobufjs": "7.6.6",
    "sharp": "0.34.5",
    "vite": "6.4.3"
  },
  "config": {
    "protocVersion": "36.2"
  },
  "engines": {
    "node": ">=22"
  }
}
